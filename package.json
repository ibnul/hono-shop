{
  "name": "hono-shop",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "predev": "npm run prisma:generate && npm run css:build",
    "prebuild": "npm run prisma:generate && npm run css:build",
    "pretest": "npm run prisma:generate",
    "css:build": "tailwindcss -i ./styles/admin.css -o ./public/admin.css --minify",
    "css:watch": "tailwindcss -i ./styles/admin.css -o ./public/admin.css --watch"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.18",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.18",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "mariadb": "^3.5.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.1.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
